# Leave VITE_API_BASE empty to use the built-in "/api" proxy -> VITE_PROXY_TARGET.
# Set it only if the browser must call the backend directly (then enable CORS on the API).
VITE_API_BASE=
# Where the dev server forwards /api/*. The backend listens on 8080.
VITE_PROXY_TARGET=http://localhost:8080

# Where the "Open simulator" button points (cmd/citysim, port 8090). Link only; no API calls go there.
VITE_SIM_URL=http://localhost:8090
