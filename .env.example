# VarunaSetu local configuration (copy to .env; never commit real secrets)
POSTGRES_USER=hydroledger
POSTGRES_PASSWORD=change-me-for-any-shared-environment
POSTGRES_DB=hydroledger
POSTGRES_PORT=5432
API_PORT=8080
DASHBOARD_PORT=5173
# Browser dev origin for CORS (set narrowly in non-dev)
CORS_ALLOW_ORIGIN=http://localhost:5173
# Dashboard -> API base (browser-visible)
VITE_API_BASE=http://localhost:8080
# Optional: run service integration tests against a DB
# HYDROLEDGER_TEST_DATABASE_URL=postgres://hydroledger:change-me@localhost:5432/hydroledger?sslmode=disable
